# Full setup checklist: ../docs/CONFIGURATION.md
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_server_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_PRICE_ID_PRO=price_your_pro_price

NEXT_PUBLIC_ENVDOCK_VERSION=0.1.0
NEXT_PUBLIC_ENVDOCK_RELEASE_DATE=June 2026
R2_PUBLIC_BASE_URL=https://downloads.envdock.app

# Desktop authentication callback. This value is public and must remain the fixed custom protocol route.
NEXT_PUBLIC_ENVDOCK_DESKTOP_CALLBACK_URL=envdock://auth/callback
NEXT_PUBLIC_DOWNLOAD_MACOS_ARM64_URL=https://downloads.example.com/EnvDock-0.1.0-arm64.dmg
NEXT_PUBLIC_DOWNLOAD_MACOS_X64_URL=https://downloads.example.com/EnvDock-0.1.0-x64.dmg
NEXT_PUBLIC_DOWNLOAD_MACOS_ARM64_SHA256=
NEXT_PUBLIC_DOWNLOAD_MACOS_X64_SHA256=
NEXT_PUBLIC_MACOS_NOTARIZED=false
